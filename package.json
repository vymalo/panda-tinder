{
  "name": "panda-tinder",
  "version": "2.0.0",
  "private": true,
  "description": "A swipe-to-match dating site where every profile is a panda.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.18",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
